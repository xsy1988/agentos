# 复制为 .env 使用（.env 已被 gitignore，不入库）

# PostgreSQL（docker-compose 使用）
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_password
POSTGRES_DB=agent_platform

# 后端连接串（backend 使用）
DATABASE_URL=postgresql+asyncpg://agent:agent_dev_password@localhost:5432/agent_platform

# 认证密钥（生产前务必更换）
SECRET_KEY=change-me-in-production

# 第三方开发者开放注册接口令牌（X-API-Key 头）；不配置 = 开放接口停用
# OPEN_API_TOKEN=generate-a-random-long-token

# ============ 自建网页搜索服务（docker compose --profile search，可选）============
# 后端只经 MCP 标准通道消费它，核心进程零新依赖（设计方案 §7.3）。
# 端口默认 8204（容器内固定 8200）：8200 在部分开发机上被桌面外设常驻进程占着，
# 而且它 accept 连接却从不响应 → OrbStack 会静默跳过发布，表现为「容器 healthy 但 curl 超时」。
# 改了 SEARCH_API_PORT 就必须同步改下面两个 URL，否则后端 seed 会把能力登记为 unhealthy
SEARCH_API_PORT=8204
SEARCH_MCP_URL=http://localhost:8204/mcp
SEARCH_REST_BASE_URL=http://localhost:8204

# Crawl4AI 的静态令牌：crawler 与 search-api 必须成对配置。
# 0.9+ 版本未设令牌时只绑容器内 loopback，发布的端口是死的（抽取会全程降级）
# CRAWL4AI_API_TOKEN=agentos-crawler-local-token

# 精排模型下载源（国内网络默认镜像站；能直连 huggingface 时改成 https://huggingface.co）
# HF_ENDPOINT=https://hf-mirror.com

# 精排模型与推理调参（实测：CPU 上成本 ≈ pairs × tokens²，128 token ≈ 0.18s/对）
# RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
# RERANK_THREADS=0            # 0 = 自动 min(8, cpu_count)，线程给太多反而变慢
# RERANK_BATCH_SIZE=8         # 实测全面优于 16
# RERANK_MAX_LENGTH=256       # reranker 服务端默认 token 上限
# RERANK_BUDGET_S=12          # 超预算就停止打分并返回已算部分（partial）

# 流水线调参（不填则用 services/websearch/src/websearch/config.py 的默认值）
# RERANK_CANDIDATES=20        # 只精排 RRF 头部 N 条；候选窗口仍为 50，recall@50 不受影响
# RERANK_DOC_MAX_LENGTH=128   # 文档级 token 上限
# RERANK_SCORE_THRESHOLD=0.05 # 低于此分的候选直接丢（0=关闭）；调高更干净但冷门查询可能空手
# PASSAGE_MAX_LENGTH=256      # 片段级 token 上限（片段更需要完整上下文）
# PASSAGE_CANDIDATES=4        # 每篇先用零成本词覆盖分预筛到 N 块，再交 cross-encoder
# EXTRACT_TOP_N=3             # 对精排 top10 的前 N 篇抽正文（延迟主要来源）
# SEARXNG_ENGINES=            # 空 = 用 searxng/settings.yml 的默认引擎集
